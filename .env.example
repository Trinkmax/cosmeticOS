# ─── Supabase ──────────────────────────────────────────────────────────────
# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://tbjbezwtblecbrluwmtw.supabase.co

# Publishable key (cliente). Buscar en Supabase → Settings → API → "publishable"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxx

# Service role (server-only — NUNCA exponer al cliente).
# Buscar en Supabase → Settings → API → "service_role secret"
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# Anon key (legacy, opcional si todavía no migraste todo a publishable)
# SUPABASE_ANON_KEY=eyJxxxxx

# ─── App ───────────────────────────────────────────────────────────────────
# URL pública del deploy. En Vercel se setea con la URL de producción.
NEXT_PUBLIC_APP_URL=https://cosmeticos.app

# ─── WhatsApp ──────────────────────────────────────────────────────────────
# Verify token del webhook de Meta (debe coincidir con el configurado en Meta Business)
WHATSAPP_META_VERIFY_TOKEN=cosmeticos-production-verify-token-CHANGE-ME

# ─── Baileys worker (opcional, si vas a usar WhatsApp no-oficial) ──────────
# BAILEYS_WORKER_URL=https://baileys.cosmeticos.app
# BAILEYS_WORKER_SECRET=shared-secret-CHANGE-ME
